@echo off
chcp 65001 > nul
title 도로대장 시설물 조사옵션 엑셀 변환기
cd /d "%~dp0"

echo ================================================================
echo   [도로대장 시설물 조사옵션] 엑셀 -^> JS 자동 변환 프로그램
echo ================================================================
echo.

if "%~1"=="" (
    echo [안내] 엑셀 파일 선택 창이 열립니다. 변환할 엑셀 파일을 선택해 주세요.
    echo        (창에서 취소할 경우 기본 파일이 자동 선택됩니다)
    echo.
    python convert_excel_to_config.py
) else (
    echo [안내] 선택/드래그된 엑셀 파일로 변환을 진행합니다:
    echo        "%~nx1"
    echo.
    python convert_excel_to_config.py "%~1"
)

echo.
echo ================================================================
echo   작업이 완료되었습니다. 창을 닫으려면 아무 키나 누르세요.
echo ================================================================
pause > nul
